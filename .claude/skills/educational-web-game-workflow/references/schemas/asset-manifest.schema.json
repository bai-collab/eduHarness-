{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-manifest.schema.json",
  "title": "Educational Game Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetId", "format", "source", "version", "sha256", "units", "upAxis", "boundingBox", "components", "animations", "textures", "budgets", "fallback"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "assetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "format": {"enum": ["glb", "gltf", "svg", "png", "webp", "procedural"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "author", "url", "license", "inputImageLicense"],
      "properties": {
        "kind": {"enum": ["self-authored", "user-provided", "procedural", "licensed-library", "ai-candidate"]},
        "author": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "inputImageLicense": {"type": "string", "minLength": 1}
      }
    },
    "version": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "units": {"enum": ["meter", "centimeter", "millimeter", "pixel", "unitless"]},
    "upAxis": {"enum": ["X", "Y", "Z"]},
    "boundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "number", "exclusiveMinimum": 0},
        "y": {"type": "number", "exclusiveMinimum": 0},
        "z": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["mesh", "node", "socket", "collision", "placeholder"]},
          "triangleCount": {"type": "integer", "minimum": 0}
        }
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "durationMs"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "durationMs": {"type": "integer", "minimum": 0},
          "loop": {"type": "boolean"}
        }
      }
    },
    "textures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "width", "height", "bytes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triangles", "drawCalls", "downloadBytes"],
      "properties": {
        "triangles": {"type": "integer", "minimum": 0},
        "drawCalls": {"type": "integer", "minimum": 0},
        "downloadBytes": {"type": "integer", "minimum": 0}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeholder", "domEquivalent", "timeoutMs"],
      "properties": {
        "placeholder": {"type": "string", "minLength": 1},
        "domEquivalent": {"type": "string", "minLength": 1},
        "timeoutMs": {"type": "integer", "minimum": 0}
      }
    }
  }
}
