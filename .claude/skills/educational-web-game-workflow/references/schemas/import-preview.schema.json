{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "import-preview.schema.json",
  "title": "Educational Game Import Preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "previewId", "projectRoot", "sourceArtifacts", "destinationPaths", "allowedPaths", "dependencies", "expectedChanges", "assetHashes", "rollback", "approval", "driftRecheck"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "previewId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "projectRoot": {"type": "string", "minLength": 1},
    "sourceArtifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "destinationPaths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?!.*\\.\\.).+"}},
    "allowedPaths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?!.*\\.\\.).+"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "expectedChanges": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "assetHashes": {"type": "array", "items": {"$ref": "#/$defs/assetHash"}},
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastKnownGoodManifest", "placeholder", "domOnly", "actions"],
      "properties": {
        "lastKnownGoodManifest": {"type": "string", "minLength": 1},
        "placeholder": {"type": "string", "minLength": 1},
        "domOnly": {"type": "string", "minLength": 1},
        "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approvedBy", "approvedAt"],
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected"]},
        "approvedBy": {"type": "string"},
        "approvedAt": {"type": "string"}
      }
    },
    "driftRecheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checkedAt", "paths"],
      "properties": {
        "status": {"enum": ["not-run", "pass", "fail"]},
        "checkedAt": {"type": "string"},
        "paths": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!.*\\.\\.).+"},
        "sha256": {"$ref": "#/$defs/hash"},
        "role": {"enum": ["source", "manifest", "dependency", "decoder"]}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation", "overwrite", "oldSha256", "newSha256", "rollbackAction"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!.*\\.\\.).+"},
        "operation": {"enum": ["create", "update", "delete"]},
        "overwrite": {"type": "boolean"},
        "oldSha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"const": null}]},
        "newSha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"const": null}]},
        "rollbackAction": {"type": "string", "minLength": 1}
      }
    },
    "assetHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "oldSha256", "newSha256"],
      "properties": {
        "assetId": {"type": "string", "minLength": 1},
        "oldSha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"const": null}]},
        "newSha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"const": null}]}
      }
    }
  }
}
