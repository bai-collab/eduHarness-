{
  "schema_version": 2,
  "kind": "local-brain-index",
  "portable": true,
  "load_policy": "on-demand",
  "paths": {
    "skills": "brain/skills",
    "knowledge": "brain/knowledge",
    "templates": "brain/templates",
    "experience": "brain/experience",
    "error_log": "brain/error-log",
    "instincts": "brain/instincts",
    "wiki_index": "brain/wiki-index.md"
  },
  "collections": [
    {
      "id": "skills",
      "path_key": "skills",
      "kind": "skill-packages",
      "load": "task-triggered",
      "authority": "executable-contract"
    },
    {
      "id": "knowledge",
      "path_key": "knowledge",
      "kind": "reviewed-markdown",
      "load": "on-demand",
      "authority": "reviewed-reference"
    },
    {
      "id": "experience",
      "path_key": "experience",
      "kind": "retrospective-markdown",
      "load": "on-demand",
      "authority": "reusable-experience"
    },
    {
      "id": "error_log",
      "path_key": "error_log",
      "kind": "verified-failure-markdown",
      "load": "on-demand",
      "authority": "failure-evidence"
    },
    {
      "id": "instincts",
      "path_key": "instincts",
      "kind": "short-safety-rules",
      "load": "startup-light",
      "authority": "advisory-safety-memory"
    }
  ]
}
