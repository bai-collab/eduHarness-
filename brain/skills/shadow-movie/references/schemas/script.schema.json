{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shadow-movie/script.schema.json",
  "title": "ShadowMovieScriptV020",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "scenes"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "title", "location", "time", "description", "characters", "duration_estimate"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "location": {"type": "string"},
          "time": {"type": "string"},
          "description": {"type": "string"},
          "characters": {"type": "array", "items": {"type": "string"}},
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["character", "text"],
              "properties": {"character": {"type": "string"}, "text": {"type": "string"}}
            }
          },
          "narration": {"type": "string"},
          "sound": {"type": "array", "items": {"type": "string"}},
          "duration_estimate": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
