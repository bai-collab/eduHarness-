{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixture-case.schema.json",
  "title": "Educational Web Game Workflow Fixture Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "category", "inputs", "expected", "assertions", "evidencePolicy"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "fixtureId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "category": {"enum": ["positive", "negative", "missing"]},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "material": {"type": ["string", "null"]},
        "learningObjectives": {"type": ["array", "null"], "items": {"type": "string"}},
        "branch": {"enum": ["web", "physical", "both", null]},
        "assetLicense": {"enum": ["verified", "missing", "unlicensed", null]},
        "assetPath": {"enum": ["workspace", "escape", null]},
        "remoteModel": {"enum": ["approved-pinned", "unknown", null]},
        "assetFormat": {"enum": ["glb", "svg", "none", null]}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "route", "stopRule"],
      "properties": {
        "status": {"enum": ["intake-only", "spec-ready", "implementation-preview", "experimental-blocked", "stopped"]},
        "route": {"enum": ["educational-web-game-workflow", "material-to-quest-game", "quest-threejs-adoption", "image-to-3d-scene"]},
        "stopRule": {"type": "string", "minLength": 1}
      }
    },
    "assertions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syntheticOnly", "browserEvidenceRequired"],
      "properties": {
        "syntheticOnly": {"const": true},
        "browserEvidenceRequired": {"type": "boolean"}
      }
    }
  }
}
