{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-spec.schema.json",
  "title": "Educational Web Game Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gameId",
    "branch",
    "learningObjectives",
    "learnerProfile",
    "levels",
    "domBaseline",
    "assessmentMetrics",
    "accessibilityRequirements",
    "assetPolicy",
    "stopRules"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "gameId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "branch": {"const": "web"},
    "learningObjectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "successEvidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
          "description": {"type": "string", "minLength": 1},
          "successEvidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "learnerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ageGroup", "prerequisites"],
      "properties": {
        "ageGroup": {"type": "string", "minLength": 1},
        "prerequisites": {"type": "array", "items": {"type": "string"}}
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "learningObjectiveIds", "domTask", "successCriteria"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
          "learningObjectiveIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "domTask": {"type": "string", "minLength": 1},
          "successCriteria": {"type": "string", "minLength": 1}
        }
      }
    },
    "domBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeWithout3d", "interactionMode", "equivalentTask"],
      "properties": {
        "completeWithout3d": {"const": true},
        "interactionMode": {"enum": ["dom", "svg", "canvas", "hybrid"]},
        "equivalentTask": {"type": "string", "minLength": 1}
      }
    },
    "assessmentMetrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "metric", "measure"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
          "metric": {"type": "string", "minLength": 1},
          "measure": {"type": "string", "minLength": 1}
        }
      }
    },
    "accessibilityRequirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedSources", "licenseReviewRequired", "unknownRemoteBlocked"],
      "properties": {
        "allowedSources": {"type": "array", "minItems": 1, "items": {"enum": ["self-authored", "user-provided", "cc0", "direct-license", "procedural", "ai-candidate"]}},
        "licenseReviewRequired": {"const": true},
        "unknownRemoteBlocked": {"const": true}
      }
    },
    "stopRules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
