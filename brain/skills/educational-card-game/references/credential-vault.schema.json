{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "educational-card-game/credential-vault.schema.json",
  "title": "Educational Card Game Credential Vault Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "credentialId", "schoolKey", "courseKey", "studentKey", "verifier", "salt", "verifierAlgorithm", "verifierVersion", "status", "createdAtMs"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "credentialId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "schoolKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "courseKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "studentKey": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{1,63}$"},
    "verifier": {"type": "string", "minLength": 16, "pattern": "^[A-Za-z0-9_-]+$"},
    "salt": {"type": "string", "minLength": 8, "pattern": "^[A-Za-z0-9_-]+$"},
    "verifierAlgorithm": {"enum": ["keyed-verifier", "argon2id", "scrypt", "bcrypt", "pbkdf2-sha256"]},
    "verifierVersion": {"type": "string", "pattern": "^[a-zA-Z0-9._-]{1,32}$"},
    "ciphertextEnvelope": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["format", "cipherSuite", "ciphertext", "nonce", "tag", "keyReference", "keyVersion", "aadVersion"],
      "properties": {
        "format": {"const": "envelope-v1"},
        "cipherSuite": {"enum": ["AEAD-approved-by-KMS-policy"]},
        "ciphertext": {"type": "string", "minLength": 16, "pattern": "^[A-Za-z0-9_-]+$"},
        "wrappedDek": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+$"},
        "nonce": {"type": "string", "minLength": 8, "pattern": "^[A-Za-z0-9_-]+$"},
        "tag": {"type": "string", "minLength": 8, "pattern": "^[A-Za-z0-9_-]+$"},
        "keyReference": {"type": "string", "minLength": 1},
        "keyVersion": {"type": "string", "minLength": 1},
        "aadVersion": {"const": "credential-scope-v1"}
      }
    },
    "createdAtMs": {"type": "integer", "minimum": 0},
    "rotatedAtMs": {"type": ["integer", "null"], "minimum": 0},
    "failedAttempts": {"type": "integer", "minimum": 0},
    "lockedUntil": {"type": ["integer", "null"], "minimum": 0},
    "status": {"enum": ["active", "disabled", "reset-required", "expired"]}
  }
}
