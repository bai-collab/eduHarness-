{
  "schemaVersion": "1.0",
  "mode": "C2",
  "preProvisionedRoster": true,
  "publicRegisterAllowed": false,
  "pin": {
    "purpose": "classroom-login",
    "assurance": "low-classroom",
    "lengthMin": 4,
    "lengthMax": 6,
    "numericOnly": true
  },
  "rateLimits": {
    "perStudent": true,
    "perLaunch": true,
    "perSchool": true
  },
  "adminRevealAllowed": true,
  "externalKms": true,
  "vaultSeparate": true,
  "reauthRequired": true,
  "singleRecordOnly": true,
  "reasonCodeRequired": true,
  "independentAuditSink": true,
  "resetAllowed": true,
  "plaintextStored": false,
  "pinInEvents": false,
  "pinInLogs": false,
  "pinInFrontendStorage": false
}
