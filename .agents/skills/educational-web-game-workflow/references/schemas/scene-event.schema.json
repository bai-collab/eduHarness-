{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene-event.schema.json",
  "title": "Educational Game Scene Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "eventId", "sceneInstanceId", "questRevision", "correlationId", "type", "payload"],
  "properties": {
    "contractVersion": {"const": "1.0"},
    "eventId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "sceneInstanceId": {"type": "string", "minLength": 1},
    "questRevision": {"type": "integer", "minimum": 0},
    "correlationId": {"type": "string", "minLength": 1},
    "type": {"enum": ["scene.ready", "hotspot.selected", "object.collectRequested", "animation.completed", "scene.failed"]},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hotspotId": {"type": "string", "minLength": 1},
        "objectId": {"type": "string", "minLength": 1},
        "animationName": {"type": "string", "minLength": 1},
        "runtimeState": {"enum": ["idle", "loading", "ready", "active", "degraded", "disposed"]},
        "errorCode": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "scene.ready"}}}, "then": {"properties": {"payload": {"required": ["runtimeState"]}}}},
    {"if": {"properties": {"type": {"const": "hotspot.selected"}}}, "then": {"properties": {"payload": {"required": ["hotspotId"]}}}},
    {"if": {"properties": {"type": {"const": "object.collectRequested"}}}, "then": {"properties": {"payload": {"required": ["objectId"]}}}},
    {"if": {"properties": {"type": {"const": "animation.completed"}}}, "then": {"properties": {"payload": {"required": ["animationName"]}}}},
    {"if": {"properties": {"type": {"const": "scene.failed"}}}, "then": {"properties": {"payload": {"required": ["errorCode", "reason"]}}}}
  ]
}
