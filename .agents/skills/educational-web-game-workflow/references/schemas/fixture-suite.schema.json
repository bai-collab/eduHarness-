{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixture-suite.schema.json",
  "title": "Educational Web Game Workflow Fixture Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "fixture-case.schema.json"}
    }
  },
  "allOf": [
    {"properties": {"cases": {"contains": {"properties": {"category": {"const": "positive"}}}, "minContains": 3}}},
    {"properties": {"cases": {"contains": {"properties": {"category": {"const": "negative"}}}, "minContains": 2}}},
    {"properties": {"cases": {"contains": {"properties": {"category": {"const": "missing"}}}, "minContains": 1}}}
  ]
}
