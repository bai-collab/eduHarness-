{
  "schema_version": 1,
  "skill_id": "item-authoring",
  "source_of_truth": "brain/skills/item-authoring/SKILL.md",
  "requires": ["filesystem.read", "filesystem.write"],
  "inputs": {
    "grade": {
      "type": "string",
      "required": true,
      "description": "學段。SKILL.md 停止規則：缺少即停止正式命題，只輸出缺件報告。"
    },
    "subject": {
      "type": "string",
      "required": true,
      "description": "科目。硬停止輸入。"
    },
    "source": {
      "type": "string",
      "required": true,
      "enum": ["user-supplied", "official", "reference", "unknown"],
      "description": "教材／來源與其標記。硬停止輸入；標記須為四類之一。"
    },
    "indicator_scope": {
      "type": "string",
      "required": true,
      "description": "學習指標範圍。硬停止輸入。"
    },
    "item_count": {
      "type": "integer",
      "required": false,
      "minimum": 1,
      "description": "題數。完整命題所需，但非 SKILL.md 硬停止輸入。"
    },
    "item_type": {
      "type": "string",
      "required": false,
      "description": "題型。"
    },
    "difficulty": {
      "type": "string",
      "required": false,
      "description": "難度。"
    },
    "answer_format": {
      "type": "string",
      "required": false,
      "description": "答案格式。"
    },
    "language": {
      "type": "string",
      "required": false,
      "description": "使用語言。"
    },
    "human_review": {
      "type": "boolean",
      "required": false,
      "description": "人工審查需求。"
    }
  },
  "outputs": {
    "artifacts": [
      {"path": "intake-gap.md", "required": false, "condition": "有缺件時"},
      {"path": "indicator-checklist.md", "required": true},
      {"path": "source-ledger.md", "required": true},
      {"path": "coverage-matrix.md", "required": true},
      {"path": "item-blueprint.md", "required": true},
      {"path": "item-bank-draft.md", "required": true},
      {"path": "review-report.md", "required": true},
      {"path": "human-review-brief.md", "required": true}
    ]
  }
}
